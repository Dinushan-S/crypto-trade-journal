PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: shared secret used to authorize the Vercel Cron keep-alive endpoint
# (/api/keep-alive). Set the same value in Vercel's project env vars; Vercel
# sends it as `Authorization: Bearer <CRON_SECRET>` on scheduled invocations.
CRON_SECRET=your_random_cron_secret
