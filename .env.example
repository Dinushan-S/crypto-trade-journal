# From `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment

PUBLIC_CONVEX_URL=https://your-instance.convex.cloud

# Set on the Convex deployment itself (`npx convex env set ...`), not here:
#   JWT_PRIVATE_KEY  RS256 private key used to sign auth JWTs
#   JWKS             matching public JWKS
#   SITE_URL         app origin, e.g. http://localhost:5173
